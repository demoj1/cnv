{
  "name": "cnv",
  "version": "0.1.0",
  "description": "Бесконечный холст с карточками, картинками, PDF и живыми веб-страницами",
  "main": "./out/main/index.js",
  "author": "Dmitry Dubina",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run rebuild:native && npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "gen:bench": "node scripts/gen-bench-canvas.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron-toolkit/utils": "4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "5.0.0",
    "dompurify": "3.4.16",
    "markdown-it": "15.0.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.3.289",
    "rbush": "4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "homepage": "https://github.com/demoj1/cnv",
  "desktopName": "cnv.desktop",
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}

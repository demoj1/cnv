				"terminal": {
					"name": "Шустрая Василиса",
					"role": "разработчик: пишет код по задачам тимлида и отчитывается ему через agent_send",
					"agent": {
						"prompt": "Вызови mcp__cnv__whoami, запомни свою роль и связи и жди сообщений от тимлида."
					}
				}
			}
		},
